# ── Django core ───────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Public base URL. QR codes and email links are built from this value.
# On PythonAnywhere: https://<your-username>.pythonanywhere.com
DJANGO_BASE_URL=http://localhost:8000

# Optional: only needed behind a proxy that does not send X-Forwarded-Proto.
# DJANGO_SECURE_SSL_REDIRECT=True

# ── Database ─────────────────────────────────────────────────
# Leave unset locally to use SQLite (db.sqlite3).
# PythonAnywhere free accounts: leave unset (SQLite).
# MySQL example: mysql://user:password@user.mysql.pythonanywhere-services.com/user$dbname
# PostgreSQL example: postgres://user:password@host:5432/dbname
# DATABASE_URL=
DB_CONN_MAX_AGE=0

# ── Media (Cloudinary) ───────────────────────────────────────
# Optional. Without these, uploads are stored in ./media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ────────────────────────────────────────────────────
# Option 1 (recommended on PythonAnywhere free): Brevo over HTTPS.
# ANYMAIL_BREVO_API_KEY=xkeysib-...
#
# Option 2: SMTP. Blocked on PythonAnywhere free accounts.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
#
# Option 3: leave everything unset to print emails to the console.
DEFAULT_FROM_EMAIL="BAIUST Computer Club" <you@example.com>
